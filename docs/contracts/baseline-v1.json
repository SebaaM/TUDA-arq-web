{
  "openapi": "3.0.3",
  "info": {
    "title": "TUDA Activities API",
    "version": "v1",
    "description": "API para consultar actividades, participantes e inscripciones. Las operaciones bajo /me usan el header X-Participant-ID como identidad controlada de demostración; no implementan autenticación real."
  },
  "paths": {
    "/api/v1/activities/": {
      "get": {
        "operationId": "listActivities",
        "description": "Devuelve todas las actividades ordenadas por fecha de inicio, con cupos disponibles.",
        "summary": "Listar actividades",
        "tags": [
          "Activities"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    },
    "/api/v1/activities/{activity_id}/": {
      "get": {
        "operationId": "getActivity",
        "description": "Recupera una actividad concreta a partir de su UUID.",
        "summary": "Obtener una actividad",
        "parameters": [
          {
            "in": "path",
            "name": "activity_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador único de la actividad.",
            "required": true
          }
        ],
        "tags": [
          "Activities"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    },
    "/api/v1/me/enrollments/": {
      "get": {
        "operationId": "listMyEnrollments",
        "description": "Lista las inscripciones del participante indicado por X-Participant-ID.",
        "summary": "Listar mis inscripciones",
        "parameters": [
          {
            "in": "header",
            "name": "X-Participant-ID",
            "schema": {
              "type": "string"
            },
            "description": "UUID del participante de demostración. Se usa como identidad de laboratorio; no es autenticación real.",
            "required": true
          }
        ],
        "tags": [
          "Enrollments"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Enrollment"
                  }
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    },
    "/api/v1/me/enrollments/{activity_id}/": {
      "put": {
        "operationId": "putMyEnrollment",
        "description": "Crea la inscripción (201) o devuelve la existente (200) si se repite.",
        "summary": "Inscribirse en una actividad",
        "parameters": [
          {
            "in": "header",
            "name": "X-Participant-ID",
            "schema": {
              "type": "string"
            },
            "description": "UUID del participante de demostración. Se usa como identidad de laboratorio; no es autenticación real.",
            "required": true
          },
          {
            "in": "path",
            "name": "activity_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador único de la actividad.",
            "required": true
          }
        ],
        "tags": [
          "Enrollments"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrollment"
                }
              }
            },
            "description": ""
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enrollment"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          }
        }
      },
      "delete": {
        "operationId": "deleteMyEnrollment",
        "description": "Elimina la inscripción (204). Una repetición también responde 204.",
        "summary": "Cancelar mi inscripción",
        "parameters": [
          {
            "in": "header",
            "name": "X-Participant-ID",
            "schema": {
              "type": "string"
            },
            "description": "UUID del participante de demostración. Se usa como identidad de laboratorio; no es autenticación real.",
            "required": true
          },
          {
            "in": "path",
            "name": "activity_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador único de la actividad.",
            "required": true
          }
        ],
        "tags": [
          "Enrollments"
        ],
        "security": [
          {}
        ],
        "responses": {
          "204": {
            "description": "Inscripción cancelada."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    },
    "/api/v1/participants/": {
      "get": {
        "operationId": "listParticipants",
        "summary": "Listar participantes",
        "tags": [
          "Participants"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    },
    "/api/v1/participants/{participant_id}/": {
      "get": {
        "operationId": "getParticipant",
        "summary": "Obtener un participante",
        "parameters": [
          {
            "in": "path",
            "name": "participant_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identificador único del participante.",
            "required": true
          }
        ],
        "tags": [
          "Participants"
        ],
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": ""
          },
          "405": {
            "description": "Método no permitido."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Activity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 0
          },
          "available_slots": {
            "type": "integer",
            "readOnly": true,
            "description": "Cupos disponibles según las inscripciones persistidas."
          }
        },
        "required": [
          "available_slots",
          "capacity",
          "id",
          "starts_at",
          "title"
        ]
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "activity_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "enrolled_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "activity_id",
          "enrolled_at"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
